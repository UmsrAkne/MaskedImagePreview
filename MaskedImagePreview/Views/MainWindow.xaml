<Window
    x:Class="MaskedImagePreview.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dd="urn:gong-wpf-dragdrop"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewModels="clr-namespace:MaskedImagePreview.ViewModels"
    Title="{Binding Title}"
    Width="1280"
    Height="720"
    d:DataContext="{d:DesignInstance viewModels:MainWindowViewModel}"
    d:DesignHeight="400"
    d:DesignWidth="800"
    mc:Ignorable="d">

    <Window.Resources>
        <Style x:Key="DropZoneListBoxStyle" TargetType="ListBox">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#DDD" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBox">
                        <Border
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                            <Grid>
                                <!-- リスト本体 -->
                                <ScrollViewer Padding="{TemplateBinding Padding}" Focusable="false">
                                    <ItemsPresenter />
                                </ScrollViewer>

                                <!-- 空状態のプレースホルダー -->
                                <Border
                                    x:Name="EmptyPrompt"
                                    Margin="6"
                                    Background="#FAFAFA"
                                    BorderBrush="#AAA"
                                    BorderThickness="2"
                                    CornerRadius="4"
                                    IsHitTestVisible="False"
                                    Visibility="Collapsed">
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock
                                            Margin="4"
                                            HorizontalAlignment="Center"
                                            FontSize="12"
                                            FontWeight="Bold"
                                            Foreground="#888"
                                            Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                                            TextAlignment="Center"
                                            TextWrapping="Wrap" />
                                        <TextBlock
                                            Margin="0,4,0,0"
                                            HorizontalAlignment="Center"
                                            FontSize="11"
                                            Foreground="#AAA"
                                            Text="📁 ドロップして追加" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>
                        <!-- アイテムが0件のときにプレースホルダーを表示 -->
                        <ControlTemplate.Triggers>
                            <Trigger Property="HasItems" Value="False">
                                <Setter TargetName="EmptyPrompt" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>

        <!-- トップバー -->
        <Border
            Grid.Row="0"
            Grid.Column="0"
            Grid.ColumnSpan="2"
            Height="40"
            Background="Aquamarine" />

        <!-- サイドバー -->
        <Border
            Grid.Row="0"
            Grid.RowSpan="2"
            Grid.Column="0"
            Width="300"
            HorizontalAlignment="Left"
            AllowDrop="True"
            Background="LightSlateGray">

            <UniformGrid Columns="2">
                <GroupBox Margin="4" Header="ベース画像">
                    <ListBox
                        dd:DragDrop.DropHandler="{Binding BaseImageViewModel}"
                        dd:DragDrop.IsDropTarget="True"
                        AllowDrop="True"
                        ItemsSource="{Binding BaseImageViewModel.ImageViewModels}"
                        SelectedItem="{Binding BaseImageViewModel.SelectedImage}"
                        Style="{StaticResource DropZoneListBoxStyle}"
                        Tag="ベース画像を&#x0a;ドロップ">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="2">
                                    <Image
                                        Width="28"
                                        Height="28"
                                        DockPanel.Dock="Left"
                                        Source="{Binding ImageSource}"
                                        Stretch="Uniform" />
                                    <TextBlock
                                        Margin="6,0,0,0"
                                        VerticalAlignment="Center"
                                        Text="{Binding FileName}"
                                        TextTrimming="CharacterEllipsis" />
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </GroupBox>

                <!-- 右列：マスク画像リスト -->
                <GroupBox Margin="4" Header="マスク画像">
                    <ListBox
                        dd:DragDrop.DropHandler="{Binding MaskImageViewModel}"
                        dd:DragDrop.IsDropTarget="True"
                        AllowDrop="True"
                        ItemsSource="{Binding MaskImageViewModel.ImageViewModels}"
                        SelectedItem="{Binding MaskImageViewModel.SelectedImage}"
                        Style="{StaticResource DropZoneListBoxStyle}"
                        Tag="マスク画像を&#x0a;ドロップ">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="2">
                                    <Image
                                        Width="28"
                                        Height="28"
                                        DockPanel.Dock="Left"
                                        Source="{Binding ImageSource}"
                                        Stretch="Uniform" />
                                    <TextBlock
                                        Margin="6,0,0,0"
                                        VerticalAlignment="Center"
                                        Text="{Binding FileName}"
                                        TextTrimming="CharacterEllipsis" />
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </GroupBox>
            </UniformGrid>

        </Border>

        <!-- メインコンテンツ（画像表示部分） -->
        <Border
            x:Name="Border"
            Grid.Row="1"
            Grid.Column="1"
            Margin="10"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            dd:DragDrop.DropHandler="{Binding}"
            dd:DragDrop.IsDropTarget="True"
            AllowDrop="True"
            Background="LightGray"
            ClipToBounds="True"
            MouseWheel="Border_PreviewMouseWheel">
            <Border.LayoutTransform>
                <ScaleTransform ScaleX="0.5" ScaleY="0.5" />
            </Border.LayoutTransform>

            <Grid>
                <!-- 1. マスク適用レイヤー（ベース画像） -->
                <Grid>
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="OpacityMask" Value="{x:Null}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding MaskImageViewModel.SelectedImage.ImageSource, Converter={StaticResource NullToBooleanConverter}}" Value="True">
                                    <Setter Property="OpacityMask">
                                        <Setter.Value>
                                            <ImageBrush
                                                AlignmentX="Center"
                                                AlignmentY="Center"
                                                ImageSource="{Binding MaskImageViewModel.SelectedImage.ImageSource}"
                                                Stretch="None"
                                                ViewportUnits="Absolute">
                                                <ImageBrush.Viewport>
                                                    <MultiBinding Converter="{StaticResource RectConverter}">
                                                        <Binding ElementName="Border" Path="ActualWidth" />
                                                        <Binding ElementName="Border" Path="ActualHeight" />
                                                    </MultiBinding>
                                                </ImageBrush.Viewport>
                                            </ImageBrush>
                                        </Setter.Value>
                                    </Setter>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>

                    <!-- 操作対象のベース画像 -->
                    <Image
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        LostMouseCapture="Image_LostMouseCapture"
                        MouseLeftButtonDown="Image_MouseLeftButtonDown"
                        MouseLeftButtonUp="Image_MouseLeftButtonUp"
                        MouseMove="Image_MouseMove"
                        RenderOptions.BitmapScalingMode="NearestNeighbor"
                        RenderTransformOrigin="0.5,0.5"
                        Source="{Binding BaseImageViewModel.SelectedImage.ImageSource}"
                        Stretch="None">
                        <Image.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform ScaleX="{Binding BaseImageViewModel.SelectedImage.Scale}" ScaleY="{Binding BaseImageViewModel.SelectedImage.Scale}" />
                                <RotateTransform Angle="{Binding BaseImageViewModel.SelectedImage.Angle}" />
                                <TranslateTransform X="{Binding BaseImageViewModel.SelectedImage.OffsetX}" Y="{Binding BaseImageViewModel.SelectedImage.OffsetY}" />
                            </TransformGroup>
                        </Image.RenderTransform>
                    </Image>
                </Grid>

                <!-- 2. マスク画像のサイズに合わせた枠線（オーバーレイ） -->
                <!-- IsHitTestVisible="False" にして画像ドラッグ操作の邪魔をしないようにする -->
                <Border
                    Width="{Binding MaskImageViewModel.SelectedImage.ImageSource.PixelWidth}"
                    Height="{Binding MaskImageViewModel.SelectedImage.ImageSource.PixelHeight}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    BorderBrush="Black"
                    BorderThickness="2"
                    IsHitTestVisible="False">
                    <Border.Style>
                        <Style TargetType="Border">
                            <!-- マスク画像がない時は枠線を非表示にする -->
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding MaskImageViewModel.SelectedImage.ImageSource}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                </Border>
            </Grid>
        </Border>

        <!-- ステータスバー -->
        <Border
            Grid.Row="2"
            Grid.Column="0"
            Grid.ColumnSpan="2"
            Height="30"
            Background="LightGoldenrodYellow">
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                <StackPanel.Resources>
                    <Style TargetType="TextBlock">
                        <Setter Property="FontSize" Value="14" />
                        <Setter Property="Margin" Value="10,0" />
                        <Setter Property="VerticalAlignment" Value="Center" />
                    </Style>
                </StackPanel.Resources>
                <TextBlock Text="{Binding BaseImageViewModel.SelectedImage.FileName}" />

                <TextBlock Text="{Binding BaseImageViewModel.SelectedImage.PixelWidth, StringFormat={}W: {0:N0}}" />
                <TextBlock Text="{Binding BaseImageViewModel.SelectedImage.PixelHeight, StringFormat={}H: {0:N0}}" />

                <Border Width="0" Margin="10,0" />

                <TextBlock Width="40" Text="{Binding BaseImageViewModel.SelectedImage.OffsetX, StringFormat={}X:{0:N0}}" />
                <TextBlock Width="40" Text="{Binding BaseImageViewModel.SelectedImage.OffsetY, StringFormat={}Y:{0:N0}}" />

                <TextBlock Text="{Binding BaseImageViewModel.SelectedImage.Angle, StringFormat={}Angle:{0:N2}}" />
                <TextBlock Text="{Binding BaseImageViewModel.SelectedImage.Scale, StringFormat={}Scale:{0:N2}}" />
            </StackPanel>
        </Border>
    </Grid>
</Window>