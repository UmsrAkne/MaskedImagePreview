<prism:PrismApplication
    x:Class="MaskedImagePreview.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:MaskedImagePreview.Converters"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:prism="http://prismlibrary.com/"
    xmlns:system="clr-namespace:System;assembly=System.Runtime">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <materialDesign:BundledTheme
                    BaseTheme="Dark"
                    PrimaryColor="Blue"
                    SecondaryColor="Amber" />

                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/materialdesign2.defaults.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <SolidColorBrush x:Key="DarkBackgroundBrush" Color="#191922" />
            <SolidColorBrush x:Key="MediumBackgroundBrush" Color="#222233" />
            <SolidColorBrush x:Key="LightBackgroundBrush" Color="#303044" />
            <SolidColorBrush x:Key="LightBorderBrush" Color="#9999EE" />
            <SolidColorBrush x:Key="ControlBackgroundBrush" Color="#222233" />
            <system:Double x:Key="CommonFontSize">16.0</system:Double>
            <converters:NullToBooleanConverter x:Key="NullToBooleanConverter" />
        </ResourceDictionary>
    </Application.Resources>
</prism:PrismApplication>